local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/nickexeqq-sketch/Test/refs/heads/main/Library.lua"))()

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer

local mainWindow = library:Window("Auto Race Start Bot")

local SavedRemotes = {}
local Waiting = false
local AutoStart = false
local LastDetect = {}

local TargetPlayer
local WaitPlayer
local CurrentRace
local RaceConnection
local MainStart

-- =========================
-- DETECTOR DE CORRIDA
-- =========================

local function SetupRaceDetector()

    if RaceConnection then
        task.cancel(RaceConnection)
    end

    if not CurrentRace then
        
        warn("Nenhuma corrida selecionada")
        return
    end

    local race = workspace.Races:FindFirstChild(CurrentRace)

    if not race then
        
        warn("Corrida não encontrada:", CurrentRace)
        return
    end

    library:Notify(
        "Monitorando "..CurrentRace,
        4
    )

    print("Monitorando:", CurrentRace)

    RaceConnection = task.spawn(function()

        local Finished = false

        while task.wait(0.2) do

            if not AutoStart then
                continue
            end

            if not race or not race.Parent then
                break
            end

            local state = race:GetAttribute("PlayersStr")

            print("Estado:", state)

            if state == "Finishing race" and not Finished then
                
                Finished = true

                print("FINALIZOU")

                library:Notify(
                    CurrentRace.." terminou!",
                    3
                )

                task.wait(1)

                MainStart()
            end

            if state ~= "Finishing race" then
                
                Finished = false
            end
        end
    end)
end

-- =========================
-- HOOK REMOTES
-- =========================

local mt = getrawmetatable(game)
local old = mt.__namecall

setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)

    local args = {...}
    local method = getnamecallmethod()

    if method == "FireServer" and Waiting then

        local alreadySaved = false

        for _, data in ipairs(SavedRemotes) do
            
            if data.Remote == self then
                alreadySaved = true
                break
            end
        end

        if not alreadySaved then

            local foundRace = false

            table.insert(SavedRemotes, {
                Remote = self,
                Args = args
            })

            -- Detecta corrida automaticamente
            for _, arg in ipairs(args) do

                print("ARG:", arg, typeof(arg))

                if typeof(arg) == "string" then

                    local racesFolder = workspace:FindFirstChild("Races")

                    if racesFolder then

                        local race = racesFolder:FindFirstChild(arg)

                        if race then

                            foundRace = true

                            CurrentRace = race.Name

                            print("Corrida detectada:", CurrentRace)

                            SetupRaceDetector()

                            break
                        end
                    end
                end
            end

            print("\n======= REMOTE "..#SavedRemotes.." SALVO =======")
            print("Nome:", self.Name)
            print("Path:", self:GetFullName())

            for i, v in ipairs(args) do
                print("Arg", i, v)
            end

            print("================================")

            library:Notify(
                "Remote "..#SavedRemotes.." salvo!",
                3
            )
        end

        if #SavedRemotes >= 2 then

            Waiting = false

            library:Notify(
                "2 remotes configurados!",
                5
            )
        end
    end

    return old(self, ...)
end)

-- =========================
-- MAIN START
-- =========================

MainStart = function()

    task.wait(WaitPlayer or 0)

    if #SavedRemotes < 2 then
        
        library:Notify(
            "Configure os remotes primeiro!",
            4
        )

        return
    end

    print("Executando remotes...")

    for i, data in ipairs(SavedRemotes) do

        local newArgs = table.clone(data.Args)

        -- Atualiza corrida automaticamente
        for index, arg in ipairs(newArgs) do

            if typeof(arg) == "string" then

                local raceFolder = workspace:FindFirstChild("Races")

                if raceFolder then

                    local race = raceFolder:FindFirstChild(arg)

                    if race then

                        print("Atualizando corrida:", arg)

                        newArgs[index] = race.Name
                    end
                end
            end
        end

        pcall(function()

            data.Remote:FireServer(unpack(newArgs))

        end)

        print("Remote "..i.." executado")

        task.wait(1)
    end
end

-- =========================
-- PLAYER DETECT
-- =========================

local function PlayerDetected(playerFound)

    local currentTime = tick()

    if LastDetect[playerFound.Name] then

        local seconds = math.floor(
            currentTime - LastDetect[playerFound.Name]
        )

        library:Notify(
            playerFound.Name.." apareceu novamente após "..seconds.."s",
            5
        )
    else

        library:Notify(
            playerFound.Name.." entrou no servidor!",
            5
        )
    end

    LastDetect[playerFound.Name] = currentTime

    MainStart()
end

-- =========================
-- ANTI AFK
-- =========================

player.Idled:Connect(function()

    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())

end)

-- =========================
-- DETECTA PLAYERS
-- =========================

for _, plr in ipairs(Players:GetPlayers()) do

    if plr.Name == TargetPlayer then
        
        PlayerDetected(plr)
    end
end

Players.PlayerAdded:Connect(function(plr)

    if plr.Name == TargetPlayer then
        
        PlayerDetected(plr)
    end
end)

