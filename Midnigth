local function SetupRaceDetector()

    print("SETUP CHAMADO")

    if not CurrentRace then
        
        warn("Nenhuma corrida selecionada")
        
        return
    end

    local racesFolder = workspace:FindFirstChild("Races")

    if not racesFolder then
        
        warn("Pasta Races não encontrada")

        return
    end

    local race = racesFolder:FindFirstChild(CurrentRace)

    if not race then
        
        warn("Corrida não encontrada:", CurrentRace)

        return
    end

    library:Notify(
        "Monitorando "..CurrentRace,
        4
    )

    print("Monitorando corrida:", CurrentRace)

    task.spawn(function()

        local lastPlayers = ""

        while AutoStart do

            task.wait(0.2)

            if not race or not race.Parent then
                continue
            end

            local playersStr = race:GetAttribute("PlayersStr")
            local countdownStr = race:GetAttribute("CountdownStr")

            if playersStr ~= lastPlayers then

                print("PlayersStr:", playersStr)
                print("CountdownStr:", countdownStr)

                lastPlayers = playersStr

                if tostring(playersStr) == "Finishing race" then

                    print("FINALIZOU")

                    library:Notify(
                        CurrentRace.." terminou!",
                        3
                    )

                    task.wait(1)

                    MainStart()
                end
            end
        end
    end)
end

