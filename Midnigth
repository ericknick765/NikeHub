        5
    )
end)

mainWindow:Box("Wait Load Player", "Time", function(WaitV)

    WaitPlayer = tonumber(WaitV)
end)

mainWindow:Button("configure remotes", function()

    table.clear(SavedRemotes)

    Waiting = true

    library:Notify(
        "Esperando 2 remotes...",
        5
    )

    print("Faça a corrida manualmente.")
end)
