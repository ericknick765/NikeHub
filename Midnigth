local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/nickexeqq-sketch/Test/refs/heads/main/Library.lua"))()

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer

local mainWindow = library:Window("Auto Race Start Bot")

local SavedRemotes = {}
local Waiting = false
local AutoStart = false
local LastDetect = {}

local TargetPlayer
local WaitPlayer
local CurrentRace
local RaceConnection
local MainStart

-- =========================
-- DETECTOR DE CORRIDA (CORRIGIDO & OTIMIZADO)
-- =========================

local function SetupRaceDetector()
    -- Cancela conexões antigas para evitar duplicação de loops
    if RaceConnection then
        task.cancel(RaceConnection)
        RaceConnection = nil
    end

    if not CurrentRace then
        warn("Nenhuma corrida selecionada para monitoramento.")
        return
    end

    library:Notify("Monitorando " .. CurrentRace, 4)
    print("Iniciando monitoramento dinâmico de:", CurrentRace)

    RaceConnection = task.spawn(function()
        local Finished = false

        while true do
            task.wait(0.3) -- Intervalo otimizado para não dar lag e não perder o timing

            if not AutoStart then
                continue
            end

            -- BUSCA DINÂMICA: Procura a corrida do zero a cada ciclo.
            -- Se ela for deletada e recriada pelo jogo, o script não quebra!
            local racesFolder = workspace:FindFirstChild("Races")
            local race = racesFolder and racesFolder:FindFirstChild(CurrentRace)

            if not race then
                -- Se a corrida sumiu do mapa (rodada resetando), reseta o estado e aguarda ela voltar
                if Finished then
                    Finished = false
                end
                continue
            end

            local state = race:GetAttribute("PlayersStr")

            -- Verifica se o atributo existe e se contém a frase (independente de maiúsculas/minúsculas)
            if typeof(state) == "string" then
                local stateLower = string.lower(state)
                local isFinishing = string.find(stateLower, "finishing race")

                if isFinishing then
                    if not Finished then
                        Finished = true
                        print("检测 [FINALIZOU] - Atributo:", state)

                        library:Notify(CurrentRace .. " terminou!", 3)
                        
                        task.wait(1) -- Pequena folga antes de reiniciar
                        MainStart()
                    end
                else
                    -- Se o texto mudou para qualquer outra coisa, libera para a próxima detecção
                    Finished = false
                end
            else
                -- Se o atributo for nil ou não for string, reseta o gatilho
                Finished = false
            end
        end
    end)
end

-- =========================
-- HOOK REMOTES
-- =========================

local mt = getrawmetatable(game)
local old = mt.__namecall

setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if method == "FireServer" and Waiting then
        local alreadySaved = false

        for _, data in ipairs(SavedRemotes) do
            if data.Remote == self then
                alreadySaved = true
                break
            end
        end

        if not alreadySaved then
            table.insert(SavedRemotes, {
                Remote = self,
                Args = args
            })

            -- Detecta corrida automaticamente pelos argumentos do Remote
            for _, arg in ipairs(args) do
                if typeof(arg) == "string" then
                    local racesFolder = workspace:FindFirstChild("Races")
                    if racesFolder and racesFolder:FindFirstChild(arg) then
                        CurrentRace = arg
                        print("Corrida detectada via Remote:", CurrentRace)
                        SetupRaceDetector()
                        break
                    end
                end
            end

            print("\n======= REMOTE " .. #SavedRemotes .. " SALVO =======")
            print("Nome:", self.Name)
            print("Path:", self:GetFullName())
            for i, v in ipairs(args) do
                print("Arg", i, v)
            end
            print("================================")

            library:Notify("Remote " .. #SavedRemotes .. " salvo!", 3)
        end

        if #SavedRemotes >= 2 then
            Waiting = false
            library:Notify("2 remotes configurados com sucesso!", 5)
        end
    end

    return old(self, ...)
end)

-- =========================
-- MAIN START
-- =========================

MainStart = function()
    if #SavedRemotes < 2 then
        library:Notify("Configure os remotes primeiro!", 4)
        return
    end

    if WaitPlayer and WaitPlayer > 0 then
        print("Aguardando tempo configurado do player:", WaitPlayer .. "s")
        task.wait(WaitPlayer)
    end

    print("Executando remotes gravados...")

    for i, data in ipairs(SavedRemotes) do
        local newArgs = table.clone(data.Args)

        -- Garante que o argumento do remote sempre use o nome atualizado da corrida
        for index, arg in ipairs(newArgs) do
            if typeof(arg) == "string" then
                local raceFolder = workspace:FindFirstChild("Races")
                if raceFolder and raceFolder:FindFirstChild(arg) then
                    newArgs[index] = arg
                end
            end
        end

        pcall(function()
            data.Remote:FireServer(unpack(newArgs))
        end)

        print("Remote " .. i .. " disparado.")
        task.wait(2) -- Delay preventivo entre os remotes para evitar ban/kick por spam
    end
end

-- =========================
-- PLAYER DETECT
-- =========================

local function PlayerDetected(playerFound)
    local currentTime = tick()

    if LastDetect[playerFound.Name] then
        local seconds = math.floor(currentTime - LastDetect[playerFound.Name])
        library:Notify(playerFound.Name .. " apareceu novamente após " .. seconds .. "s", 5)
    else
        library:Notify(playerFound.Name .. " entrou no servidor!", 5)
    end

    LastDetect[playerFound.Name] = currentTime
    MainStart()
end

-- =========================
-- ANTI AFK
-- =========================

player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- =========================
-- DETECTA PLAYERS
-- =========================

for _, plr in ipairs(Players:GetPlayers()) do
    if plr.Name == TargetPlayer then
        PlayerDetected(plr)
    end
end

Players.PlayerAdded:Connect(function(plr)
    if plr.Name == TargetPlayer then
        PlayerDetected(plr)
    end
end)

-- =========================
-- UI CONFIG
-- =========================

mainWindow:Toggle("Auto-Start", function(state)
    AutoStart = state
    if state then
        library:Notify("Auto-Start ativado!", 3)
        -- Se já houver uma corrida ativa definida, reinicia o detector ao ligar a UI
        if CurrentRace then
            SetupRaceDetector()
        end
    else
        library:Notify("Auto-Start desativado!", 3)
    end
end)

mainWindow:Box("Player Finder", "Name", function(BoxPlayer)
    TargetPlayer = tostring(BoxPlayer)
    library:Notify("Agora detectando: " .. TargetPlayer, 5)
end)

mainWindow:Box("Wait Load Player", "Time", function(WaitV)
    WaitPlayer = tonumber(WaitV)
end)

mainWindow:Button("configure remotes", function()
    table.clear(SavedRemotes)
    Waiting = true
    library:Notify("Esperando 2 remotes... Entre na corrida manualmente.", 5)
    print("Modo de captura ativado. Vá até a corrida e inicie-a.")
end)
