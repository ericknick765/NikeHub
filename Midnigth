local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/nickexeqq-sketch/Test/refs/heads/main/Library.lua"))()

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer

local mainWindow = library:Window("Auto Race Start Bot")

local SavedRemotes = {}
local Waiting = false
local AutoStart = false
local LastDetect = {}

local TargetPlayer
local WaitPlayer
local CurrentRace

local MainStart
local RaceConnection
local RaceChildConnection

--========================
-- RACE DETECTOR
--========================

local function ConnectRace(race)

    if RaceConnection then
        RaceConnection:Disconnect()
    end

    print("Conectado na corrida:", race.Name)

    library:Notify(
        "Monitorando "..race.Name,
        4
    )

    local lastState = nil

    RaceConnection = race:GetAttributeChangedSignal("PlayersStr"):Connect(function()

        local state = race:GetAttribute("PlayersStr")

        if state == lastState then
            return
        end

        lastState = state

        print("Novo estado:", state)

        -- MUDE AQUI CASO O TEXTO FINAL SEJA DIFERENTE
        if tostring(state) == "Finishing race" then

            print("CORRIDA FINALIZADA")

            library:Notify(
                race.Name.." terminou!",
                3
            )

            task.wait(1)

            if AutoStart then
                MainStart()
            end
        end
    end)
end

local function SetupRaceDetector()

    if not CurrentRace then
        
        warn("Nenhuma corrida selecionada")
        
        return
    end

    local racesFolder = workspace:WaitForChild("Races")

    print("Monitorando:", CurrentRace)

    -- reconecta se a corrida recriar
    if RaceChildConnection then
        RaceChildConnection:Disconnect()
    end

    RaceChildConnection = racesFolder.ChildAdded:Connect(function(child)

        if child.Name == CurrentRace then

            print("Corrida recriada:", child.Name)

            task.wait(0.5)

            ConnectRace(child)
        end
    end)

    local race = racesFolder:FindFirstChild(CurrentRace)

    if race then
        ConnectRace(race)
    end
end

--========================
-- HOOK REMOTES
--========================

local mt = getrawmetatable(game)
local old = mt.__namecall

setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)

    local args = {...}
    local method = getnamecallmethod()

    if method == "FireServer" and Waiting then

        local alreadySaved = false

        for _, data in ipairs(SavedRemotes) do

            if data.Remote == self then
                alreadySaved = true
                break
            end
        end

        if not alreadySaved then

            local foundRace = false

            table.insert(SavedRemotes, {
                Remote = self,
                Args = args
            })

            for _, arg in ipairs(args) do

                print("ARG:", arg, typeof(arg))

                if typeof(arg) == "string" then

                    local racesFolder = workspace:FindFirstChild("Races")

                    if racesFolder then

                        local race = racesFolder:FindFirstChild(arg)

                        if race then

                            foundRace = true

                            CurrentRace = race.Name

                            print("Corrida detectada:", CurrentRace)

                            break
                        end
                    end
                end
            end

            if foundRace then
                SetupRaceDetector()
            end

            print("\n======= REMOTE "..#SavedRemotes.." SALVO =======")
            print("Nome:", self.Name)
            print("Path:", self:GetFullName())

            for i, v in ipairs(args) do
                print("Arg", i, v)
            end

            print("================================")

            library:Notify(
                "Remote "..#SavedRemotes.." salvo!",
                3
            )
        end

        if #SavedRemotes >= 2 then

            Waiting = false

            library:Notify(
                "2 remotes configurados!",
                5
            )
        end
    end

    return old(self, ...)
end)

--========================
-- MAIN START
--========================

MainStart = function()

    task.wait(WaitPlayer or 0)

    if #SavedRemotes < 2 then

        library:Notify(
            "Configure os remotes primeiro!",
            4
        )

        return
    end

    print("Executando remotes...")

    for i, data in ipairs(SavedRemotes) do

        local newArgs = table.clone(data.Args)

        -- atualiza automaticamente corrida
        for index, arg in ipairs(newArgs) do

            if typeof(arg) == "string" then

                local racesFolder = workspace:FindFirstChild("Races")

                if racesFolder then

                    local race = racesFolder:FindFirstChild(arg)

                    if race then

                        print("Atualizando corrida:", arg)

                        newArgs[index] = race.Name
                    end
                end
            end
        end

        pcall(function()
            data.Remote:FireServer(unpack(newArgs))
        end)

        print("Remote "..i.." executado")

        task.wait(1)
    end
end

--========================
-- PLAYER DETECTOR
--========================

local function PlayerDetected(playerObj)

    local currentTime = tick()

    if LastDetect[playerObj.Name] then

        local seconds = math.floor(
            currentTime - LastDetect[playerObj.Name]
        )

        library:Notify(
            playerObj.Name.." apareceu novamente após "..seconds.."s",
            5
        )
    else

        library:Notify(
            playerObj.Name.." entrou no servidor!",
            5
        )
    end

    LastDetect[playerObj.Name] = currentTime

    MainStart()
end

for _, playerObj in ipairs(Players:GetPlayers()) do

    if playerObj.Name == TargetPlayer then
        PlayerDetected(playerObj)
    end
end

Players.PlayerAdded:Connect(function(playerObj)

    if playerObj.Name == TargetPlayer then
        PlayerDetected(playerObj)
    end
end)

