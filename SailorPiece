local function getClosestMob()
    local closest = nil
    local distance = MaxDistance

    for _, mob in pairs(workspace:GetDescendants()) do
        if mob:IsA("Model") then

            local humanoid = mob:FindFirstChildOfClass("Humanoid")
            local root = mob:FindFirstChild("HumanoidRootPart")

            if humanoid and root and humanoid.Health > 0 and mob ~= player.Character then

                local valid = false

                for _, mobName in pairs(selectedMob) do
                    if string.find(string.lower(mob.Name), string.lower(mobName)) then
                        valid = true
                        break
                    end
                end

                if valid then
                    local mag = (player.Character.HumanoidRootPart.Position - root.Position).Magnitude

                    if mag < distance then
                        distance = mag
                        closest = root
                    end
                end
            end
        end
    end

    return closest
end

local function AutoSetStats ()
        local statusQnt = player.Data.StatPoints.Value
        if statusQnt <= 0 then return end
        local divided  = math.floor(statusQnt  / #selectedStat)
        
        for _, selected in pairs(selectedStat) do
              AllocatedStat:FireServer(selected, divided)
        end
        
end

