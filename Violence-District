local Players = game:GetService("Players")
local User = Players.LocalPlayer

local ALLOWED_PLACE_ID = 93978595733734

local WhitelistPlayer = {
    [11520255455] = true,
}

-- Verifica se está no jogo correto
if game.PlaceId ~= ALLOWED_PLACE_ID then
    return
end

local function carregar(http)
    loadstring(game:HttpGet(http))()
end

-- Verifica a whitelist
if WhitelistPlayer[User.UserId] then
    print("Admin")
    carregar('https://raw.githubusercontent.com/ericknick765/NikeHub/refs/heads/main/Violence-District.lua')
else
    -- Versão Normal
    print("Normal")
    carregar('https://raw.githubusercontent.com/ericknick765/NikeHub/refs/heads/main/Violence-District.lua')

end